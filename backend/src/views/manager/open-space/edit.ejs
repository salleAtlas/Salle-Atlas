<h1>Open space</h1>

<% if (flash.error) { %><p class="alert alert-danger"><%= flash.error %></p><% } %>
<% if (flash.success) { %><p class="alert alert-success"><%= flash.success %></p><% } %>

<form action="/manager/open-space?_method=PUT" method="POST">
  <label>Nom <input name="name" value="<%= openSpace.name %>" required></label>
  <label>Description <textarea name="description" required><%= openSpace.description %></textarea></label>
  <label>Nombre de places <input type="number" name="total_seats" min="1" step="1" value="<%= openSpace.total_seats %>" required></label>
  <label>Prix / heure / place (DT) <input type="number" name="price_per_hour_per_seat" min="0.01" step="0.01" value="<%= openSpace.price_per_hour_per_seat %>" required></label>
  <button type="submit">Enregistrer</button>
</form>
